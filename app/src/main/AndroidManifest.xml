<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!--
      Android 17 gates traffic to devices on the local network behind this
      permission (enforced for apps targeting 37; asked for up front so the
      remote keeps working when the target is raised).
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!--
      Wi-Fi is what the app normally uses, but nothing here hard-requires the
      radio: a tablet or Chromebook on Ethernet can still reach an Apple TV,
      and Play would otherwise hide the app from it.
    -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!--
      The media notification runs in a foreground service because that is what
      keeps the connections to the Apple TV alive once the app leaves the
      screen. Posting it needs consent from Android 13.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Puck">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.Puck">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".KeyboardReplyReceiver"
            android:exported="false" />

        <service
            android:name=".NowPlayingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Home-screen widget: a 1x1 tile pinned to one specific Apple TV. -->
        <receiver
            android:name=".DeviceWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/device_widget_info" />
        </receiver>

        <!--
          Exported because the system launches it on the widget host's behalf
          when a widget is dragged onto the home screen; it only ever reads
          this app's own paired-device list.
        -->
        <activity
            android:name=".DeviceWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Puck">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!--
          Long-pressing a tile opens this to pick which Apple TV it is pinned
          to — Quick Settings has no add-time configuration step the way
          widgets do, so this is the only hook Android gives for it.
        -->
        <activity
            android:name=".TileConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Puck">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!--
          One tile per saved Apple TV. The slots after the first are declared
          disabled and switched on by QuickTiles as TVs are paired, because
          Android cannot add a tile at runtime.
        -->
        <service
            android:name=".DeviceTileOne"
            android:exported="true"
            android:icon="@drawable/ic_widget_remote"
            android:label="@string/tile_label_1"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".DeviceTileTwo"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_widget_remote"
            android:label="@string/tile_label_2"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".DeviceTileThree"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_widget_remote"
            android:label="@string/tile_label_3"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".DeviceTileFour"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_widget_remote"
            android:label="@string/tile_label_4"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".DeviceTileFive"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_widget_remote"
            android:label="@string/tile_label_5"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".DeviceTileSix"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_widget_remote"
            android:label="@string/tile_label_6"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".DeviceTileSeven"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_widget_remote"
            android:label="@string/tile_label_7"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".DeviceTileEight"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_widget_remote"
            android:label="@string/tile_label_8"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
