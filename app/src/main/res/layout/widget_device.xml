<?xml version="1.0" encoding="utf-8"?>
<!--
  Still styled to read as a normal app icon with a label underneath, not a
  themed card — on most launchers a 1x1 widget sits in the grid
  indistinguishably from any other icon. Restyled per DESIGN_SPEC.md §9:
  three stacked layers RemoteViews can render (<shape>, a vector, and
  android:alpha — no gradients or shadows) — tile background, a faint ring,
  the remote glyph.

  The icon fills whatever space the launcher actually hands the widget
  (weight="1", not a fixed dp size) — a fixed size assumes a cell close to
  a launcher's own icon size, but a OneUI grid cell runs considerably
  bigger than that, and a fixed-size icon just sat in the middle of the
  extra space looking tiny next to every real icon around it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="4dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_tile_bg">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="9dp"
            android:alpha="0.4"
            android:src="@drawable/widget_ring"
            android:importantForAccessibility="no" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_widget_remote"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="11sp"
        android:textColor="@color/widget_on_background"
        tools:text="Living Room" />

</LinearLayout>
