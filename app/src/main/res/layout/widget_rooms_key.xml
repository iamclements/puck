<?xml version="1.0" encoding="utf-8"?>
<!-- A room key, normal height. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/w_key" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
    android:layout_margin="3dp" android:background="@drawable/w_key">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/w_mark_34">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_widget_remote"
                android:tint="@color/puck_w_glyph" android:importantForAccessibility="no" />
        </FrameLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="4dp" />
        <TextView android:id="@+id/w_name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium" android:textSize="11.5sp" android:maxLines="1" android:ellipsize="end"
            android:includeFontPadding="false" android:gravity="center" android:paddingStart="4dp" android:paddingEnd="4dp"
            android:textColor="@color/puck_w_on_surface" tools:text="Bedroom" />
        <TextView android:id="@+id/w_name_last" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium" android:textStyle="bold" android:visibility="gone" android:textSize="11.5sp" android:maxLines="1" android:ellipsize="end"
            android:includeFontPadding="false" android:gravity="center" android:paddingStart="4dp" android:paddingEnd="4dp"
            android:textColor="@color/puck_w_on_surface" tools:text="Bedroom" />
    </LinearLayout>
    <ImageView android:id="@+id/w_last_dot" android:layout_width="7dp" android:layout_height="7dp" android:layout_gravity="top|end"
        android:layout_marginTop="7dp" android:layout_marginEnd="8dp" android:src="@drawable/w_dot_hero" android:visibility="gone"
        android:importantForAccessibility="no" />
</FrameLayout>
