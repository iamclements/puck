<?xml version="1.0" encoding="utf-8"?>
<!-- The Add TV key: dashed outline, plus icon. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/w_key" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
    android:layout_margin="3dp" android:background="@drawable/w_key_add">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
        <ImageView android:id="@+id/w_add_icon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_w_add"
            android:tint="@color/puck_w_on_surface_variant" android:importantForAccessibility="no" />
        <TextView android:id="@+id/w_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium" android:textSize="11.5sp" android:maxLines="1" android:ellipsize="end"
            android:includeFontPadding="false" android:gravity="center" android:text="@string/widget_rooms_add"
            android:textColor="@color/puck_w_on_surface_variant" />
    </LinearLayout>
</FrameLayout>
