<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Window background matches PuckTheme's fallback surface so there is no
      dark-to-light flash on launch for people on a light system theme.
      System bar colours are left to enableEdgeToEdge(); Android 15+ ignores
      them anyway.
    -->
    <style name="Theme.Puck" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
